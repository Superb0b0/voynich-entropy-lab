{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/voynich/anchor_entry.rev3.schema.json",
  "title": "Voynich ANCHOR evidence entry v1.1.0 DRAFT revision 3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "branch",
    "experiment",
    "classification",
    "status",
    "claim",
    "source_files",
    "verification",
    "gate_effect",
    "evidence_level",
    "execution"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ANC-[0-9]{4}$"
    },
    "branch": {
      "const": "EXPLORATORY_ANCHOR"
    },
    "experiment": {
      "enum": [
        "ANCHOR-01",
        "ANCHOR-02",
        "ANCHOR-03",
        "ANCHOR-04"
      ]
    },
    "classification": {
      "const": "ESPLORATIVO"
    },
    "status": {
      "enum": [
        "PENDING",
        "PASS",
        "FAIL",
        "NOT_ACQUIRED"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filename",
          "sha256",
          "size_bytes",
          "origin",
          "canonical_id"
        ],
        "properties": {
          "filename": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "origin": {
            "type": "string"
          },
          "library_file_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "canonical_id": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "script_filename": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "script_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "command": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "execution_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "environment": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "script_filename",
        "script_sha256",
        "command",
        "execution_date"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "checked_at",
        "recomputed",
        "evidence_refs"
      ],
      "properties": {
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "recomputed": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "gate_effect": {
      "const": "NONE"
    },
    "related_folios": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_level": {
      "enum": [
        "RIPORTATO",
        "RIPRODOTTO"
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "evidence_refs"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "pattern": "\\S"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence_level": {
            "const": "RIPRODOTTO"
          },
          "verification": {
            "properties": {
              "recomputed": {
                "const": true
              },
              "reviewer": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "recomputed",
              "reviewer",
              "checked_at",
              "evidence_refs"
            ]
          },
          "execution": {
            "properties": {
              "script_filename": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "script_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "execution_date": {
                "type": "string",
                "format": "date"
              }
            },
            "required": [
              "script_filename",
              "script_sha256",
              "command",
              "execution_date"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_level": {
            "const": "RIPRODOTTO"
          }
        },
        "required": [
          "evidence_level"
        ]
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "recomputed": {
                "const": true
              },
              "evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "recomputed",
              "evidence_refs"
            ]
          },
          "execution": {
            "properties": {
              "script_filename": {
                "type": "string",
                "pattern": "\\S"
              },
              "script_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "command": {
                "type": "string",
                "pattern": "\\S"
              },
              "execution_date": {
                "type": "string",
                "format": "date"
              },
              "output_refs": {
                "type": "array",
                "minItems": 1
              }
            },
            "required": [
              "script_filename",
              "script_sha256",
              "command",
              "execution_date",
              "output_refs"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAIL"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "failure"
        ]
      }
    }
  ]
}
