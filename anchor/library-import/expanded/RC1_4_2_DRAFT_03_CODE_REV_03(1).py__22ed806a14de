class DiagnosticError(RuntimeError):
    """Raised for internal errors and fail-closed rejections."""


# ---------------------------------------------------------------------------
# Frozen result type. Closed schema: no arbitrary keys, no dict from caller.
# ---------------------------------------------------------------------------
@dataclass(frozen=True)
class RoleResult:
    role: str
    status: str
    reason: str | None = None
    path: str | None = None
    pinned_size: int | None = None
    pinned_sha256: str | None = None
    observed_size: int | None = None
    observed_sha256: str | None = None

    def to_dict(self) -> dict:
        d: dict[str, Any] = {"role": self.role, "status": self.status}
        if self.reason is not None:
            d["reason"] = self.reason
        if self.path is not None:
            d["path"] = self.path
        if self.pinned_size is not None:
            d["pinned_size"] = self.pinned_size
        if self.pinned_sha256 is not None:
            d["pinned_sha256"] = self.pinned_sha256
        if self.observed_size is not None:
            d["observed_size"] = self.observed_size
        if self.observed_sha256 is not None:
            d["observed_sha256"] = self.observed_sha256
        return d


# ---------------------------------------------------------------------------
# Pure utilities.
# ---------------------------------------------------------------------------
def sha256_of_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _canonical_json(obj: Any) -> bytes:
    return json.dumps(
        obj, ensure_ascii=False, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")


# ---------------------------------------------------------------------------
# Real byte-level verification (F-02 in the diagnostic perimeter).
# ---------------------------------------------------------------------------
def read_and_verify(path: Path, role: str) -> RoleResult:
    """
    Read the file, compute the digest on the bytes actually read, and compare
    with the pinned value. Never returns a PASS-like status.
    """
    if role not in PINNED:
        return RoleResult(
            role=role,
            status=MISMATCH,
            reason=f"no pin available for role {role!r}",
            path=str(path),
        )

    pinned_size, pinned_sha = PINNED[role]

    if not path.is_file():
        return RoleResult(
            role=role,
            status=ERROR,
            reason="file not found",
            path=str(path),
            pinned_size=pinned_size,
            pinned_sha256=pinned_sha,
        )

    try:
        data = path.read_bytes()
    except OSError as exc:
        return RoleResult(
            role=role,
            status=ERROR,
            reason=f"read error: {exc}",
            path=str(path),
            pinned_size=pinned_size,
            pinned_sha256=pinned_sha,
        )

    observed_size = len(data)
    observed_sha = sha256_of_bytes(data)

    if observed_size == pinned_size and observed_sha == pinned_sha:
        status, reason = MATCH, None
    else:
        status = MISMATCH
        reason = "observed bytes differ from pinned reference"

    return RoleResult(
        role=role,
        status=status,
        reason=reason,
        path=str(path),
        pinned_size=pinned_size,
        pinned_sha256=pinned_sha,
        observed_size=observed_size,
        observed_sha256=observed_sha,
    )


def verify_all_pinned_files(root: Path) -> dict[str, RoleResult]:
    """
    Verify the seven pinned files under `root` using the canonical filenames
    of RC1.4.2 V7.1.
    """
    return {
        role: read_and_verify(root / FILENAMES[role], role)
        for role in ROLES
    }


# ---------------------------------------------------------------------------
# Report building and schema enforcement.
# ---------------------------------------------------------------------------
def _make_report(
    verification: dict[str, RoleResult],
    root: Path,
    operator_note: str,
) -> dict:
    """
    Build a diagnostic report from RoleResult objects only. No external dict
    can be injected at this layer because RoleResult is a frozen dataclass
    with a closed field set.
    """
    per_role: dict[str, dict] = {}
    counts = {MATCH: 0, MISMATCH: 0, ERROR: 0, NOT_RUN: 0}

    for role in ROLES:
        r = verification[role]
        per_role[role] = r.to_dict()
        if r.status in counts:
            counts[r.status] += 1

    return {
        "artifact_kind": "DIAGNOSTIC_REPORT_NON_QUALIFIED",
        "artifact_status": "NOT_AUDIT_VALIDATED",
        "produced_by": "DRAFT_03_CODE_REV_03 (diagnostic generator)",
        "note": (
            "This report is diagnostic only. It is NOT one of the five "
            "qualified audit artifacts of RC1.4.2 V7.1, and it does not "
            "constitute audit validation, provenance, or repeatability."
        ),
        "contract_reference": "RC1.4.2 V7.1 rev. 02.2 (hardened) — NOT satisfied here",
        "gate": "CLOSED_PENDING_VALIDATION",
        "rp_01": "OPEN",
        "doc_04": "PENDING_EXTERNAL_ATTESTATION",
        "f085v": "UNRESOLVED_NO_IVTFF_MATCH_IN_CURRENT_PERIMETER",
        "manual_intervention_on_historical_data": False,
        "session_info": {
            "operator_note": operator_note,
            "root": str(root.resolve()),
        },
        "per_role": per_role,
        "counts": counts,
        "qualified_artifacts_produced": False,
        "audit_validation_claim": None,
        "provenance_claim": None,
        "repeatability_claim": None,
    }


_REQUIRED_TOP_KEYS = frozenset({
    "artifact_kind",
    "artifact_status",
    "produced_by",
    "note",
    "contract_reference",
    "gate",
    "rp_01",
    "doc_04",
    "f085v",
    "manual_intervention_on_historical_data",
    "session_info",
    "per_role",
    "counts",
    "qualified_artifacts_produced",
    "audit_validation_claim",
    "provenance_claim",
    "repeatability_claim",
})


def _validate_report_dict(report: Any) -> None:
    """
    Enforce the closed schema before writing. Rejects:
      - extra or missing top-level keys;
      - wrong fixed values;
      - per-role entries with unknown fields or invalid statuses;
      - a `counts` block inconsistent with the actual per_role statuses.
    """
    if not isinstance(report, dict):
        raise DiagnosticError("report is not a dict")

    keys = set(report.keys())
    if keys != _REQUIRED_TOP_KEYS:
        extra = keys - _REQUIRED_TOP_KEYS
        missing = _REQUIRED_TOP_KEYS - keys
        raise DiagnosticError(
            f"report keys do not match closed schema: extra={extra}, missing={missing}"
        )

    fixed = {
        "artifact_kind": "DIAGNOSTIC_REPORT_NON_QUALIFIED",
        "artifact_status": "NOT_AUDIT_VALIDATED",
        "gate": "CLOSED_PENDING_VALIDATION",
        "rp_01": "OPEN",
        "doc_04": "PENDING_EXTERNAL_ATTESTATION",
        "f085v": "UNRESOLVED_NO_IVTFF_MATCH_IN_CURRENT_PERIMETER",
    }
    for key, expected in fixed.items():
        if report[key] != expected:
            raise DiagnosticError(f"wrong fixed value for {key}: {report[key]!r}")

    if report["manual_intervention_on_historical_data"] is not False:
        raise DiagnosticError("manual_intervention_on_historical_data must be False")
    if report["qualified_artifacts_produced"] is not False:
        raise DiagnosticError("qualified_artifacts_produced must be False")
    for claim in ("audit_validation_claim", "provenance_claim", "repeatability_claim"):
        if report[claim] is not None:
            raise DiagnosticError(f"{claim} must be None")

    per_role = report["per_role"]
    if not isinstance(per_role, dict):
        raise DiagnosticError("per_role must be a dict")
    if set(per_role.keys()) != set(ROLES):
        raise DiagnosticError(
            f"per_role must have exactly the seven canonical roles; got {set(per_role.keys())}"
        )

    recomputed = {MATCH: 0, MISMATCH: 0, ERROR: 0, NOT_RUN: 0}
    for role in ROLES:
        entry = per_role[role]
        if not isinstance(entry, dict):
            raise DiagnosticError(f"per_role[{role}] is not a dict")
        extra = set(entry.keys()) - ALLOWED_ENTRY_KEYS
        if extra:
            raise DiagnosticError(f"forbidden fields in per_role[{role}]: {extra}")
        if entry.get("role") != role:
            raise DiagnosticError(f"per_role[{role}].role mismatch")
        status = entry.get("status")
        if status not in ALLOWED_STATUSES:
            raise DiagnosticError(f"invalid status in per_role[{role}]: {status!r}")
        if status in recomputed:
            recomputed[status] += 1

    if report["counts"] != recomputed:
        raise DiagnosticError(
            f"counts mismatch: declared={report['counts']}, recomputed={recomputed}"
        )


# ---------------------------------------------------------------------------
# No-clobber write. Enforces closed schema, O_EXCL, O_NOFOLLOW when available.
# ---------------------------------------------------------------------------
def _write_report_no_clobber(report: dict, out_dir: Path) -> Path:
    _validate_report_dict(report)

    out_dir = Path(out_dir)
    try:
        out_dir.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        raise DiagnosticError(f"cannot create out_dir {out_dir}: {exc}") from exc

    target = out_dir / "rc1_4_2_diagnostic_report.json"

    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    flags |= nofollow

    try:
        fd = os.open(target, flags, 0o644)
    except FileExistsError as exc:
        raise DiagnosticError(
            f"target already exists, refusing to overwrite: {target}"
        ) from exc
    except OSError as exc:
        raise DiagnosticError(
            f"cannot create report safely at {target}: {exc}"
        ) from exc

    try:
        payload = _canonical_json(report) + b"\n"
        os.write(fd, payload)
    finally:
        os.close(fd)

    return target


# ---------------------------------------------------------------------------
# Public entry point. Only path to the writer.
# ---------------------------------------------------------------------------
def _is_within(path: Path, ancestor: Path) -> bool:
    try:
        path.relative_to(ancestor)
        return True
    except ValueError:
        return False


def produce_diagnostic_report(
    root: Path,
    out_dir: Path,
    operator_note: str = "",
) -> tuple[Path, dict]:
    """
    Verify the seven pinned files under `root`, build the diagnostic report,
    and write it under `out_dir` with no-clobber semantics. Refuses any
    `out_dir` that resolves inside or equal to `root`.
    """
    root = Path(root)
    out_dir = Path(out_dir)

    if not root.is_dir():
        raise DiagnosticError(f"root is not a directory: {root}")

    root_resolved = root.resolve()
    out_resolved = out_dir.resolve()

    if _is_within(out_resolved, root_resolved):
        raise DiagnosticError(
            f"out_dir {out_dir} resolves inside root {root}; refusing"
        )

    verification = verify_all_pinned_files(root)
    report = _make_report(verification, root, operator_note)
    target = _write_report_no_clobber(report, out_dir)
    return target, report


# ---------------------------------------------------------------------------
# CLI.
# ---------------------------------------------------------------------------
def _parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Diagnostic generator for RC1.4.2 V7.1. "
            "Not qualified. Not hardened. Does not produce audit artifacts."
        )
    )
    parser.add_argument(
        "--root",
        required=True,
        help="Directory containing the seven pinned files",
    )
    parser.add_argument(
        "--out",
        required=True,
        help="Directory where the diagnostic report will be written",
    )
    parser.add_argument(
        "--operator-note",
        default="",
        help="Free-form note included in the diagnostic report (optional)",
    )
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = _parse_args(argv)

    try:
        target, report = produce_diagnostic_report(
            Path(args.root), Path(args.out), args.operator_note
        )
    except DiagnosticError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    print(f"diagnostic report written to {target}")
    print(f"per-role counts: {report['counts']}")

    # DBG-03: fail-closed exit code. Only all-MATCH yields success.
    matched = report["counts"].get(MATCH, 0)
    total = len(ROLES)
    if (
        matched == total
        and report["counts"].get(MISMATCH, 0) == 0
        and report["counts"].get(ERROR, 0) == 0
        and report["counts"].get(NOT_RUN, 0) == 0
    ):
        print(f"all {total} roles MATCH")
        return 0

    print(f"NOT all roles MATCH: matched={matched}/{total}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))