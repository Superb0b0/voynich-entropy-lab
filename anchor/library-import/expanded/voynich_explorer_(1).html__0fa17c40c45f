let cur=null, curSec='all', order=[];

function renderList(q='',s='all'){
  const el=document.getElementById('flist'); el.innerHTML=''; order=[];
  for(const f of foliiSorted()){
    const d=DS[f];
    if(s!=='all'&&d.section!==s)continue;
    if(q){const qq=q.toLowerCase();if(!f.includes(qq)&&!plantOf(f).toLowerCase().includes(qq))continue;}
    order.push(f);
    const sc=SCOLS[SNAMES.indexOf(d.section)]||'d6';
    const div=document.createElement('div');
    div.className='fi'+(f===cur?' on':''); div.dataset.f=f;
    div.innerHTML=`<span class="fn">f${f}</span><span class="fp">${plantOf(f)}</span><span class="fd ${sc}"></span>`;
    div.onclick=()=>loadFolio(f);
    el.appendChild(div);
  }
}

function loadFolio(f, switchView=true){
  cur=f;
  if(switchView && !document.getElementById('vBrowser').classList.contains('on')) switchTab('Browser');
  document.querySelectorAll('.fi').forEach(e=>e.classList.toggle('on',e.dataset.f===f));
  const d=DS[f], idx=order.indexOf(f);
  document.getElementById('fl').textContent='f'+f;
  document.getElementById('sl').textContent=d.section||'';
  document.getElementById('pb').onclick=()=>{if(idx>0)loadFolio(order[idx-1])};
  document.getElementById('nxb').onclick=()=>{if(idx<order.length-1)loadFolio(order[idx+1])};
  const ph=document.getElementById('osd-ph');
  if(ph)ph.remove();
  makeOSD('osd', d.iiif_id);
  renderInfo(f,d);
  document.querySelector('.fi.on')?.scrollIntoView({block:'nearest',behavior:'smooth'});
}

function renderInfo(f,d){
  const bot=d.botanical||{}, st=d.stats||{}, top5=st.top5||[], nb=d.neighbors||[];
  const sec=d.section||'Unknown';
  const rows=top5.map(t=>{
    const lr=st.n?t.n/st.n:0, gr=t.global/GN;
    const en=gr>0?(lr/gr).toFixed(1):'—', enN=parseFloat(en);
    const ec=enN>=5?'#e74c3c':enN>=2?'#e67e22':'var(--perg-m)';
    return `<tr><td class="tc" onclick="openToken('${t.tok}')">${t.tok}</td>
      <td style="text-align:right;color:var(--perg-d)">${t.n}</td>
      <td style="text-align:right;color:var(--perg-m);font-size:.72rem">${t.global}</td>
      <td style="text-align:right;color:${ec};font-size:.72rem">${isNaN(enN)?'—':en+'×'}</td></tr>`;
  }).join('');
  const nbItems=nb.slice(0,5).map(n=>{
    const pl=plantOf(n.folio);
    return `<div class="nbi" onclick="loadFolio('${n.folio}')">
      <span class="nbf">f${n.folio}</span>
      <span class="nbp">${pl}</span>
      <span class="nbpct">${n.similarity}%</span>
      <div class="nbbar"><div class="nbbf" style="width:${n.similarity}%"></div></div>
    </div>`;
  }).join('');
  const h1p=Math.min((st.H1||0)/12*100,100);
  const tp=Math.min((st.TTR||0)*100,100);
  const xp=Math.min((st.XX||0)*2000,100);
  const ap=Math.min((st.AAB||0)*2000,100);

  document.getElementById('ip').innerHTML=`
    <div class="is">
      <h3>Ipotesi botanica</h3>
      ${bot.plant?`<div class="pn">${bot.plant}</div>
        <span class="cb ${CF[bot.confidence||'']}">${CL[bot.confidence||'']}</span>
        <p class="pnt">${bot.notes||''}</p>
        <p class="psrc">Fonte: ${bot.source||'—'}</p>
        <div class="hyp-note">⚠ Ipotesi non universalmente accettata dalla comunità voynichologica.</div>`
      :`<p class="pnt" style="color:var(--perg-m)">Nessuna ipotesi botanica consolidata.</p>`}
    </div>
    <div class="is">
      <h3>Sezione · ${sec}</h3>
      <div class="sdesc">${SD[sec]||''}</div>
    </div>
    <div class="is">
      <h3>Struttura statistica</h3>
      <div class="sg">
        <div class="si"><div class="slb">Entropia H₁</div><div class="sv">${st.H1||'—'}</div>
          <div class="sbar"><div class="sbf" style="width:${h1p}%;background:var(--gold)"></div></div></div>
        <div class="si"><div class="slb">TTR</div><div class="sv">${st.TTR||'—'}</div>
          <div class="sbar"><div class="sbf" style="width:${tp}%;background:var(--gold)"></div></div></div>
        <div class="si"><div class="slb">XX rate</div><div class="sv">${st.XX||'—'}</div>
          <div class="sbar"><div class="sbf" style="width:${xp}%;background:var(--red)"></div></div></div>
        <div class="si"><div class="slb">AAB rate</div><div class="sv">${st.AAB||'—'}</div>
          <div class="sbar"><div class="sbf" style="width:${ap}%;background:var(--teal-l)"></div></div></div>
      </div>
      <p style="font-size:.66rem;color:var(--perg-m);margin-top:7px;font-family:var(--mono)">
        Token: ${st.n||0} · Unici: ${st.n&&st.TTR?Math.round(st.n*st.TTR):'—'}</p>
    </div>
    <div class="is">
      <h3>Token caratteristici <span style="color:var(--perg-m);font-weight:normal">(click → Token Explorer)</span></h3>
      <table class="ttbl">
        <thead><tr><th>Token</th><th style="text-align:right">Locale</th>
          <th style="text-align:right">Globale</th><th style="text-align:right">Enrich.</th></tr></thead>
        <tbody>${rows}</tbody>
      </table>
    </div>
    <div class="is">
      <h3>Folii più simili</h3>
      <div class="nblist">${nbItems||'<p style="color:var(--perg-m);font-size:.78rem">—</p>'}</div>
    </div>
    <div class="is">
      <div class="mnt">
        <strong>Note:</strong> i dati sono analisi computazionale (Model 408-OP, 7 fasi).
        Token ≠ traduzioni. Enrich. = frequenza locale/attesa.<br>
        Immagini © Yale Beinecke, pubblico dominio.
      </div>
    </div>`;
}

document.getElementById('srch').oninput=e=>renderList(e.target.value,curSec);
document.getElementById('sfilt').onclick=e=>{
  const b=e.target.closest('.sb2'); if(!b)return;
  document.querySelectorAll('.sb2').forEach(x=>x.classList.remove('on'));
  b.classList.add('on'); curSec=b.dataset.s;
  renderList(document.getElementById('srch').value,curSec);
};

// ══════════════════════════════════════════════
// HEATMAP VIEW
// ══════════════════════════════════════════════
function buildHeatmap(metric='H1'){
  const grid=document.getElementById('hmGrid'); grid.innerHTML='';
  const vals=foliiSorted().map(f=>DS[f]?.stats?.[metric]||0);
  const min=Math.min(...vals), max=Math.max(...vals);
  let lastSec='';
  for(const f of foliiSorted()){
    const d=DS[f];
    if(d.section!==lastSec){
      lastSec=d.section;
      const lbl=document.createElement('div');
      lbl.className='sec-label';
      lbl.textContent=d.section+' ▸';
      grid.appendChild(lbl);
    }
    const v=d.stats?.[metric]||0;
    const cell=document.createElement('div');
    cell.className='hm-cell';
    cell.style.background=metricColor(v,min,max);
    cell.innerHTML=`<span class="hm-tip">f${f}<br>${metric}: ${typeof v==='number'?v.toFixed(4):v}<br>${plantOf(f)}</span>`;
    cell.onclick=()=>loadFolio(f);
    grid.appendChild(cell);
  }
}
document.getElementById('hmMetric').onchange=e=>buildHeatmap(e.target.value);

// ══════════════════════════════════════════════
// COMPARE VIEW
// ══════════════════════════════════════════════
let osdA=null, osdB=null;
function cmpStats(f,elId){
  const d=DS[f]; if(!d)return;
  const st=d.stats||{};
  document.getElementById(elId).innerHTML=
    ['H1','TTR','XX','AAB'].map(k=>`
      <div class="cmp-stat"><div class="slb">${k}</div>
        <div class="sv">${st[k]||'—'}</div></div>`).join('');
}
function runCompare(){
  const fA=document.getElementById('cmpA').value.trim();
  const fB=document.getElementById('cmpB').value.trim();
  if(!DS[fA]||!DS[fB])return;
  document.getElementById('ctA').textContent='f'+fA+' — '+plantOf(fA);
  document.getElementById('ctB').textContent='f'+fB+' — '+plantOf(fB);
  makeOSD('osdA',DS[fA].iiif_id);
  makeOSD('osdB',DS[fB].iiif_id);
  cmpStats(fA,'csA'); cmpStats(fB,'csB');
  // similarità
  const nb=DS[fA].neighbors||[];
  const sim=nb.find(n=>n.folio===fB);
  document.getElementById('cmpSim').textContent=sim?`Similarità: ${sim.similarity}%`:'';
}

// ══════════════════════════════════════════════
// TOKEN EXPLORER
// ══════════════════════════════════════════════
let tokList=[], curTok=null;

function buildTokList(q=''){
  const el=document.getElementById('tokList'); el.innerHTML='';
  tokList=Object.entries(TI)
    .filter(([t])=>!q||t.includes(q.toLowerCase()))
    .sort((a,b)=>b[1].total-a[1].total);
  document.getElementById('tokCount').textContent=`${tokList.length} token`;
  for(const [tok,data] of tokList.slice(0,200)){
    const div=document.createElement('div');
    div.className='ti'+(tok===curTok?' on':''); div.dataset.t=tok;
    div.innerHTML=`<span class="tt">${tok}</span><span class="tn">${data.total}</span>`;
    div.onclick=()=>showToken(tok);
    el.appendChild(div);
  }
}

function openToken(tok){
  switchTab('Tokens');
  setTimeout(()=>showToken(tok),50);
}

function showToken(tok){
  curTok=tok;
  document.querySelectorAll('.ti').forEach(e=>e.classList.toggle('on',e.dataset.t===tok));
  const data=TI[tok]; if(!data)return;
  const maxN=Math.max(...data.folii.map(x=>x.n));
  const cards=data.folii.map(x=>{
    const pl=plantOf(x.f);
    return `<div class="tfc" onclick="loadFolio('${x.f}')">
      <span class="tff">f${x.f}</span>
      <span class="tfp">${pl}</span>
      <span class="tfn">${x.n}×</span>
      <div class="tfbar"><div class="tfbf" style="width:${(x.n/maxN*100).toFixed(0)}%"></div></div>
    </div>`;
  }).join('');
  document.getElementById('tokMain').innerHTML=`
    <div class="tok-header">
      <div class="tok-name">${tok}</div>
      <div class="tok-meta">Frequenza globale: ${data.total} · Presente in ${data.n_folii} folii · Significato: non determinato</div>
    </div>
    <div style="margin-bottom:12px;font-family:var(--mono);font-size:.72rem;color:var(--perg-m)">
      Folii ordinati per frequenza locale (click per aprire):
    </div>
    <div class="tok-folio-grid">${cards}</div>`;
}

document.getElementById('tokSrch').oninput=e=>buildTokList(e.target.value);

// ══════════════════════════════════════════════
// ANALYTICS VIEW
// ══════════════════════════════════════════════
function buildAnalytics(){
  const metrics=['H1','TTR','XX','AAB'];
  const labels={'H1':'Entropia H₁','TTR':'Ricchezza lessicale (TTR)',
                 'XX':'XX rate (auto-ripetizioni)','AAB':'AAB rate (enumerativo)'};
  
  let html='<div class="an-grid">';
  for(const m of metrics){
    const vals=SNAMES.filter(s=>SM[s]).map(s=>({sec:s, val:SM[s][m]?.mean||0}));
    const mx=Math.max(...vals.map(v=>v.val));
    const rows=vals.map((v,i)=>`
      <div class="an-row">
        <span class="an-sec">${v.sec.replace('-',' ')}</span>
        <div class="an-bar-wrap"><div class="an-bar ${SCBARS[i]||''}" style="width:${mx>0?(v.val/mx*100).toFixed(1):0}%"></div></div>
        <span class="an-val">${v.val.toFixed(4)}</span>
      </div>`).join('');
    html+=`<div class="an-card"><h3>${labels[m]}</h3>${rows}</div>`;
  }
  // card riassuntiva
  html+=`<div class="an-card" style="grid-column:1/-1">
    <h3>Sintesi Model 408-OP — cosa dicono i dati</h3>
    <div style="font-size:.82rem;line-height:1.75;color:var(--perg-d)">
      <p>Il Voynich non è rumore casuale (H₁ stabile per sezione) e non è un cifrario semplice
      (distribuzione incompatibile con sostituzione). È più vicino a testo tecnico medievale
      che a qualsiasi controllo sintetico testato.</p><br>
      <p><strong style="color:var(--gold)">XX rate anomalo (Z=12.5)</strong>: le auto-ripetizioni A→A
      superano di molto l'atteso casuale, con picco nella sezione Herbal-A.
      Pattern AAB (A-A-B diverso) compatibile con notazione di misura o quantità.</p><br>
      <p><strong style="color:var(--gold)">Sezione Astronomica</strong>: unica con XX rate nella norma
      statistica. Probabile registro linguistico diverso dal resto del manoscritto.</p><br>
      <p style="color:var(--perg-m);font-family:var(--mono);font-size:.72rem">
        ⚠ Questi dati sono analisi computazionale, non traduzione. Nessun token ha significato determinato.</p>
    </div>
  </div>`;
  html+='</div>';
  document.getElementById('anContent').innerHTML=html;
}

// ══════════════════════════════════════════════
// TAB SWITCHING
// ══════════════════════════════════════════════
function switchTab(name){
  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('on',t.dataset.v===name));
  document.querySelectorAll('.view').forEach(v=>v.classList.toggle('on',v.id==='v'+name));
  if(name==='Heatmap')buildHeatmap(document.getElementById('hmMetric').value);
  if(name==='Analytics')buildAnalytics();
  if(name==='Tokens'&&!curTok)buildTokList();
  if(name==='Compare'&&!document.getElementById('csA').innerHTML)runCompare();
}
document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>switchTab(t.dataset.v));

// ══════════════════════════════════════════════
// INIT
// ══════════════════════════════════════════════
renderList();
buildTokList();
const first=foliiSorted().find(f=>DS[f]?.botanical?.plant)||foliiSorted()[0];
if(first)loadFolio(first);
</script>
