<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Voynich Explorer — Model 408-OP v2</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/openseadragon/4.1.0/openseadragon.min.js"></script>
<style>
:root{
  --ink:#12100a;--perg:#f2e6cc;--perg-d:#dcc9a0;--perg-m:#b8956a;
  --gold:#c49010;--gold-l:#e8b420;--red:#7a1c0e;
  --teal:#156050;--teal-l:#1f8c72;--slate:#1e2a35;
  --mono:'Courier New',monospace;
  --panel-bg:#0e0c07;--border:rgba(196,144,16,.18);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden}
body{background:var(--ink);color:var(--perg);font-family:Georgia,serif;display:flex;flex-direction:column}

/* ── HEADER ── */
header{background:linear-gradient(#080604,var(--ink));border-bottom:2px solid var(--gold);
  padding:10px 20px;display:flex;align-items:center;gap:14px;flex-shrink:0;z-index:200}
.hg{font-size:1.9rem;color:var(--gold);font-style:italic;text-shadow:0 0 18px rgba(196,144,16,.4)}
header h1{font-size:1rem;font-weight:normal;letter-spacing:.08em}
header h1 small{display:block;font-size:.62rem;color:var(--perg-m);letter-spacing:.2em;text-transform:uppercase;margin-top:2px}
.tabs{margin-left:auto;display:flex;gap:3px}
.tab{background:transparent;border:1px solid var(--border);color:var(--perg-m);
  padding:4px 13px;font-size:.72rem;font-family:var(--mono);cursor:pointer;border-radius:1px;transition:all .14s}
.tab:hover,.tab.on{background:var(--gold);color:var(--ink);border-color:var(--gold)}

/* ── VIEWS ── */
.view{display:none;flex:1;overflow:hidden}
.view.on{display:flex}

/* ══ BROWSER VIEW ══ */
#vBrowser{flex-direction:row}
.sb{width:250px;background:#0a0804;border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0}
.sb-top{padding:10px 12px;border-bottom:1px solid var(--border);flex-shrink:0}
.sb-top input{width:100%;background:rgba(242,230,204,.06);border:1px solid var(--border);
  color:var(--perg);padding:5px 9px;font-family:var(--mono);font-size:.78rem;border-radius:2px;outline:none;margin-bottom:6px}
.sb-top input:focus{border-color:var(--gold)}
.sfilt{display:flex;flex-wrap:wrap;gap:3px}
.sb2{background:transparent;border:1px solid var(--border);color:var(--perg-m);
  padding:2px 6px;font-size:.63rem;font-family:var(--mono);cursor:pointer;border-radius:1px;transition:all .12s}
.sb2:hover,.sb2.on{background:var(--gold);color:var(--ink);border-color:var(--gold)}
.flist{overflow-y:auto;flex:1;scrollbar-width:thin;scrollbar-color:var(--gold) transparent}
.flist::-webkit-scrollbar{width:3px}
.flist::-webkit-scrollbar-thumb{background:var(--gold)}
.fi{display:flex;align-items:center;gap:7px;padding:7px 12px;cursor:pointer;
  border-bottom:1px solid rgba(196,144,16,.05);transition:background .1s}
.fi:hover{background:rgba(196,144,16,.07)}
.fi.on{background:rgba(196,144,16,.15);border-left:3px solid var(--gold);padding-left:9px}
.fn{font-family:var(--mono);font-size:.78rem;color:var(--gold);min-width:36px;font-weight:bold}
.fp{font-size:.74rem;color:var(--perg-d);flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fd{width:5px;height:5px;border-radius:50%;flex-shrink:0}

/* ── IMAGE AREA ── */
.ia{flex:1;display:flex;flex-direction:column;background:#070503;overflow:hidden}
#osd{flex:1}
.ibar{padding:7px 14px;border-top:1px solid var(--border);display:flex;align-items:center;
  gap:9px;background:rgba(0,0,0,.4);flex-shrink:0}
.nb{background:transparent;border:1px solid var(--border);color:var(--gold);
  padding:3px 11px;font-family:var(--mono);font-size:.74rem;cursor:pointer;border-radius:1px;transition:all .12s}
.nb:hover{background:var(--gold);color:var(--ink)}
.fl{font-family:var(--mono);font-size:.86rem;color:var(--gold);font-weight:bold}
.sl{font-size:.7rem;color:var(--perg-m);margin-left:auto}
.el{font-family:var(--mono);font-size:.66rem;color:var(--gold-l);text-decoration:none;
  border-bottom:1px solid rgba(196,144,16,.3);padding-bottom:1px}
.el:hover{border-color:var(--gold)}

/* ── INFO PANEL ── */
.ip{width:340px;background:var(--panel-bg);border-left:1px solid var(--border);
  overflow-y:auto;flex-shrink:0;scrollbar-width:thin;scrollbar-color:rgba(196,144,16,.25) transparent}
.ip::-webkit-scrollbar{width:3px}
.ip::-webkit-scrollbar-thumb{background:rgba(196,144,16,.3)}
.is{padding:14px 16px;border-bottom:1px solid var(--border)}
.is h3{font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);
  font-family:var(--mono);margin-bottom:9px;padding-bottom:4px;border-bottom:1px solid var(--border)}
.pn{font-size:1.1rem;color:var(--perg);margin-bottom:3px}
.cb{display:inline-block;font-family:var(--mono);font-size:.6rem;letter-spacing:.1em;
  text-transform:uppercase;padding:1px 6px;border-radius:1px;margin-bottom:7px}
.ch{background:rgba(26,107,92,.28);color:#2ecc71;border:1px solid #2ecc71}
.cm{background:rgba(196,144,16,.18);color:var(--gold-l);border:1px solid var(--gold)}
.cl{background:rgba(122,28,14,.2);color:#e74c3c;border:1px solid #c0392b}
.cn{background:rgba(60,60,60,.2);color:#666;border:1px solid #444}
.pnt{font-size:.8rem;line-height:1.65;color:var(--perg-d)}
.psrc{font-family:var(--mono);font-size:.65rem;color:var(--perg-m);margin-top:6px}
.hyp-note{font-size:.7rem;color:#e67e22;font-family:var(--mono);
  background:rgba(230,126,34,.08);border:1px solid rgba(230,126,34,.25);
  padding:5px 8px;border-radius:2px;margin-top:7px}
.sdesc{font-size:.79rem;line-height:1.65;color:var(--perg-d);
  background:rgba(21,96,80,.07);border-left:3px solid var(--teal-l);
  padding:8px 11px;border-radius:0 2px 2px 0}
.sg{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.si{background:rgba(242,230,204,.04);border:1px solid var(--border);padding:6px 8px;border-radius:2px}
.slb{font-family:var(--mono);font-size:.6rem;color:var(--perg-m);letter-spacing:.07em;text-transform:uppercase;margin-bottom:2px}
.sv{font-family:var(--mono);font-size:.95rem;color:var(--gold-l);font-weight:bold}
.sbar{height:2px;background:rgba(196,144,16,.12);border-radius:1px;margin-top:3px;overflow:hidden}
.sbf{height:100%;border-radius:1px}

/* Token table */
.ttbl{width:100%;border-collapse:collapse}
.ttbl th{font-family:var(--mono);font-size:.6rem;color:var(--perg-m);letter-spacing:.07em;
  text-transform:uppercase;text-align:left;padding:3px 6px;border-bottom:1px solid var(--border)}
.ttbl td{padding:4px 6px;font-family:var(--mono);font-size:.78rem;border-bottom:1px solid rgba(196,144,16,.05)}
.ttbl tr:hover td{background:rgba(196,144,16,.04)}
.tc{color:var(--gold-l);font-weight:bold;cursor:pointer;text-decoration:underline dotted;text-underline-offset:3px}
.tc:hover{color:var(--gold)}

/* Neighbors */
.nblist{display:flex;flex-direction:column;gap:4px}
.nbi{display:flex;align-items:center;gap:7px;padding:5px 8px;
  background:rgba(242,230,204,.04);border:1px solid var(--border);
  border-radius:2px;cursor:pointer;transition:background .1s}
.nbi:hover{background:rgba(196,144,16,.1)}
.nbf{font-family:var(--mono);font-size:.8rem;color:var(--gold);font-weight:bold;min-width:32px}
.nbp{font-size:.76rem;color:var(--perg-d);flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nbpct{font-family:var(--mono);font-size:.72rem;color:var(--teal-l)}
.nbbar{width:50px;height:4px;background:rgba(196,144,16,.1);border-radius:2px;overflow:hidden}
.nbbf{height:100%;background:var(--teal-l);border-radius:2px}
.mnt{font-size:.7rem;color:var(--perg-m);font-family:var(--mono);
  background:rgba(0,0,0,.25);border:1px solid rgba(196,144,16,.08);
  padding:8px 10px;border-radius:2px;line-height:1.6}
.mnt strong{color:var(--gold)}

/* ══ HEATMAP VIEW ══ */
#vHeatmap{flex-direction:column;padding:20px;overflow-y:auto;gap:20px}
.hm-ctrl{display:flex;align-items:center;gap:12px;flex-shrink:0}
.hm-ctrl label{font-family:var(--mono);font-size:.78rem;color:var(--perg-m)}
.hm-ctrl select{background:rgba(242,230,204,.06);border:1px solid var(--border);
  color:var(--perg);padding:4px 8px;font-family:var(--mono);font-size:.78rem;border-radius:2px;outline:none}
.hm-legend{display:flex;align-items:center;gap:8px;font-family:var(--mono);font-size:.68rem;color:var(--perg-m)}
.hm-grad{width:100px;height:8px;border-radius:2px;background:linear-gradient(90deg,#1a4a3a,#e8b420,#8b2012)}
.hm-grid{display:flex;flex-wrap:wrap;gap:3px;align-content:flex-start}
.hm-cell{width:22px;height:22px;border-radius:2px;cursor:pointer;
  transition:transform .1s,box-shadow .1s;position:relative;flex-shrink:0}
.hm-cell:hover{transform:scale(1.4);z-index:10;box-shadow:0 0 8px rgba(196,144,16,.5)}
.hm-cell .hm-tip{display:none;position:absolute;bottom:calc(100%+5px);left:50%;
  transform:translateX(-50%);background:#1a1208;border:1px solid var(--gold);
  padding:5px 9px;border-radius:2px;font-family:var(--mono);font-size:.68rem;
  white-space:nowrap;z-index:100;pointer-events:none}
.hm-cell:hover .hm-tip{display:block}
.sec-label{font-family:var(--mono);font-size:.7rem;color:var(--perg-m);
  letter-spacing:.1em;text-transform:uppercase;width:100%;margin-top:8px;padding-bottom:3px;
  border-bottom:1px solid var(--border)}

/* ══ COMPARE VIEW ══ */
#vCompare{flex-direction:column;padding:16px;gap:12px;overflow:hidden}
.cmp-ctrl{display:flex;align-items:center;gap:10px;flex-shrink:0}
.cmp-ctrl label{font-family:var(--mono);font-size:.75rem;color:var(--perg-m)}
.cmp-ctrl input{background:rgba(242,230,204,.06);border:1px solid var(--border);
  color:var(--gold);padding:4px 8px;font-family:var(--mono);font-size:.78rem;
  width:70px;border-radius:2px;outline:none;text-align:center}
.cmp-btn{background:var(--gold);border:none;color:var(--ink);
  padding:5px 14px;font-family:var(--mono);font-size:.75rem;cursor:pointer;border-radius:1px}
.cmp-panels{display:grid;grid-template-columns:1fr 1fr;gap:12px;flex:1;overflow:hidden}
.cmp-p{background:#070503;border:1px solid var(--border);border-radius:2px;display:flex;flex-direction:column;overflow:hidden}
.cmp-title{padding:6px 12px;border-bottom:1px solid var(--border);font-family:var(--mono);font-size:.8rem;color:var(--gold)}
.cmp-osd{flex:1}
.cmp-stats{padding:8px 12px;border-top:1px solid var(--border);display:grid;grid-template-columns:repeat(4,1fr);gap:6px;background:rgba(0,0,0,.3)}
.cmp-stat{text-align:center}
.cmp-stat .slb{font-size:.58rem}
.cmp-stat .sv{font-size:.82rem}

/* ══ TOKEN EXPLORER ══ */
#vTokens{flex-direction:row;overflow:hidden}
.tok-sb{width:280px;background:#0a0804;border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0}
.tok-sb-top{padding:12px;border-bottom:1px solid var(--border);flex-shrink:0}
.tok-sb-top input{width:100%;background:rgba(242,230,204,.06);border:1px solid var(--border);
  color:var(--perg);padding:6px 9px;font-family:var(--mono);font-size:.8rem;border-radius:2px;outline:none}
.tok-sb-top input:focus{border-color:var(--gold)}
.tok-sb-top p{font-size:.68rem;color:var(--perg-m);font-family:var(--mono);margin-top:6px}
.tok-list{overflow-y:auto;flex:1;scrollbar-width:thin;scrollbar-color:var(--gold) transparent}
.tok-list::-webkit-scrollbar{width:3px}
.tok-list::-webkit-scrollbar-thumb{background:var(--gold)}
.ti{display:flex;align-items:center;gap:7px;padding:7px 12px;cursor:pointer;
  border-bottom:1px solid rgba(196,144,16,.05);transition:background .1s}
.ti:hover{background:rgba(196,144,16,.07)}
.ti.on{background:rgba(196,144,16,.15);border-left:3px solid var(--gold)}
.tt{font-family:var(--mono);font-size:.82rem;color:var(--gold-l);font-weight:bold;flex:1}
.tn{font-family:var(--mono);font-size:.72rem;color:var(--perg-m);text-align:right}
.tok-main{flex:1;overflow-y:auto;padding:20px;scrollbar-width:thin;scrollbar-color:rgba(196,144,16,.2) transparent}
.tok-main::-webkit-scrollbar{width:3px}
.tok-main::-webkit-scrollbar-thumb{background:rgba(196,144,16,.3)}
.tok-header{margin-bottom:16px}
.tok-name{font-size:2rem;font-family:var(--mono);color:var(--gold);letter-spacing:.05em}
.tok-meta{font-size:.78rem;color:var(--perg-m);font-family:var(--mono);margin-top:4px}
.tok-folio-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:6px}
.tfc{display:flex;align-items:center;gap:6px;padding:6px 10px;
  background:rgba(242,230,204,.04);border:1px solid var(--border);
  border-radius:2px;cursor:pointer;transition:background .1s}
.tfc:hover{background:rgba(196,144,16,.1);border-color:rgba(196,144,16,.4)}
.tff{font-family:var(--mono);font-size:.8rem;color:var(--gold);font-weight:bold;min-width:30px}
.tfp{font-size:.74rem;color:var(--perg-d);flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tfn{font-family:var(--mono);font-size:.7rem;color:var(--perg-m)}
.tfbar{width:30px;height:3px;background:rgba(196,144,16,.1);border-radius:1px;overflow:hidden}
.tfbf{height:100%;background:var(--gold);border-radius:1px}

/* ══ SECTION ANALYTICS ══ */
#vAnalytics{flex-direction:column;padding:20px;gap:16px;overflow-y:auto}
.an-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px}
.an-card{background:#0a0804;border:1px solid var(--border);border-radius:3px;padding:14px}
.an-card h3{font-family:var(--mono);font-size:.65rem;color:var(--gold);letter-spacing:.15em;
  text-transform:uppercase;margin-bottom:12px;padding-bottom:5px;border-bottom:1px solid var(--border)}
.an-row{display:flex;align-items:center;gap:8px;margin-bottom:7px}
.an-sec{font-family:var(--mono);font-size:.75rem;color:var(--perg-d);min-width:100px}
.an-bar-wrap{flex:1;height:12px;background:rgba(196,144,16,.08);border-radius:2px;overflow:hidden}
.an-bar{height:100%;border-radius:2px;transition:width .4s ease}
.an-val{font-family:var(--mono);font-size:.72rem;color:var(--perg-m);min-width:50px;text-align:right}

/* section dots */
.d0{background:#2ecc71}.d1{background:#3498db}.d2{background:#e74c3c}
.d3{background:#f39c12}.d4{background:#9b59b6}.d5{background:#1abc9c}.d6{background:#555}

/* section bar colors */
.c0{background:#2ecc71}.c1{background:#3498db}.c2{background:#e74c3c}
.c3{background:#f39c12}.c4{background:#9b59b6}.c5{background:#1abc9c}

/* placeholder */
.ph{display:flex;flex-direction:column;align-items:center;justify-content:center;
  height:100%;gap:12px;color:var(--perg-m);text-align:center;padding:24px}
.ph-g{font-size:2.5rem;color:rgba(196,144,16,.22);font-style:italic;letter-spacing:3px}
.ph p{font-size:.8rem;line-height:1.7;max-width:260px}
.ph a{color:var(--gold-l);text-decoration:none;font-family:var(--mono);font-size:.72rem}

/* empty state */
.empty{display:flex;align-items:center;justify-content:center;height:100%;
  opacity:.35;flex-direction:column;gap:8px;font-size:.85rem}
</style>
</head>
<body>

<header>
  <div class="hg">𝔙</div>
  <h1>Voynich Explorer
    <small>Model 408-OP · MS 408 · Beinecke Library Yale · c. 1401–1599</small>
  </h1>
  <div class="tabs">
    <button class="tab on" data-v="Browser">📜 Browser</button>
    <button class="tab" data-v="Heatmap">🔥 Heatmap</button>
    <button class="tab" data-v="Compare">⚖️ Confronto</button>
    <button class="tab" data-v="Tokens">🔍 Token</button>
    <button class="tab" data-v="Analytics">📊 Analisi</button>
  </div>
</header>

<!-- ══ BROWSER ══ -->
<div class="view on" id="vBrowser">
  <div class="sb">
    <div class="sb-top">
      <input type="text" id="srch" placeholder="Cerca folio o pianta…">
      <div class="sfilt" id="sfilt">
        <button class="sb2 on" data-s="all">Tutti</button>
        <button class="sb2" data-s="Herbal-A">Herb.</button>
        <button class="sb2" data-s="Astronomical">Astr.</button>
        <button class="sb2" data-s="Biological">Bio.</button>
        <button class="sb2" data-s="Pharmaceutical">Farm.</button>
        <button class="sb2" data-s="Recipes-Stars">Ric.</button>
      </div>
    </div>
    <div class="flist" id="flist"></div>
  </div>

  <div class="ia">
    <div id="osd"><div class="ph" id="osd-ph">
      <div class="ph-g">𝔙𝔬𝔶</div>
      <p>Seleziona un folio.<br>Immagini IIIF da <a href="https://collections.library.yale.edu/catalog/2002046" target="_blank">Yale Beinecke</a>.</p>
    </div></div>
    <div class="ibar">
      <button class="nb" id="pb">← Prec</button>
      <span class="fl" id="fl">—</span>
      <button class="nb" id="nxb">Succ →</button>
      <span class="sl" id="sl"></span>
      <a class="el" id="yl" href="https://collections.library.yale.edu/catalog/2002046" target="_blank">Yale ↗</a>
    </div>
  </div>

  <div class="ip" id="ip">
    <div class="empty"><div style="font-size:2rem;font-style:italic;color:rgba(196,144,16,.2)">𝔪𝔰</div><div>Seleziona un folio</div></div>
  </div>
</div>

<!-- ══ HEATMAP ══ -->
<div class="view" id="vHeatmap">
  <div class="hm-ctrl">
    <label>Metrica:</label>
    <select id="hmMetric">
      <option value="H1">Entropia H₁</option>
      <option value="TTR">TTR (ricchezza lessicale)</option>
      <option value="XX">XX rate (auto-ripetizioni)</option>
      <option value="AAB">AAB rate (enumerativo)</option>
    </select>
    <div class="hm-legend">
      <span>Basso</span>
      <div class="hm-grad"></div>
      <span>Alto</span>
    </div>
    <span style="font-family:var(--mono);font-size:.7rem;color:var(--perg-m);margin-left:12px">Click per aprire folio</span>
  </div>
  <div class="hm-grid" id="hmGrid"></div>
</div>

<!-- ══ COMPARE ══ -->
<div class="view" id="vCompare">
  <div class="cmp-ctrl">
    <label>Folio A:</label><input type="text" id="cmpA" value="1r" placeholder="es. 1r">
    <label>Folio B:</label><input type="text" id="cmpB" value="2r" placeholder="es. 2r">
    <button class="cmp-btn" onclick="runCompare()">Confronta</button>
    <span style="font-family:var(--mono);font-size:.7rem;color:var(--perg-m);margin-left:8px" id="cmpSim"></span>
  </div>
  <div class="cmp-panels">
    <div class="cmp-p">
      <div class="cmp-title" id="ctA">Folio A</div>
      <div class="cmp-osd" id="osdA"></div>
      <div class="cmp-stats" id="csA"></div>
    </div>
    <div class="cmp-p">
      <div class="cmp-title" id="ctB">Folio B</div>
      <div class="cmp-osd" id="osdB"></div>
      <div class="cmp-stats" id="csB"></div>
    </div>
  </div>
</div>

<!-- ══ TOKEN EXPLORER ══ -->
<div class="view" id="vTokens">
  <div class="tok-sb">
    <div class="tok-sb-top">
      <input type="text" id="tokSrch" placeholder="Cerca token…">
      <p id="tokCount">1559 token (freq ≥ 3)</p>
    </div>
    <div class="tok-list" id="tokList"></div>
  </div>
  <div class="tok-main" id="tokMain">
    <div class="empty"><div style="font-size:2rem;font-style:italic;color:rgba(196,144,16,.2)">𝔱𝔬𝔨</div><div>Seleziona un token</div></div>
  </div>
</div>

<!-- ══ ANALYTICS ══ -->
<div class="view" id="vAnalytics">
  <div id="anContent"></div>
</div>

<script>
// ══════════════════════════════════════════════
