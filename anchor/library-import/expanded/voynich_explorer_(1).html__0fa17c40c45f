function sk(f){const m=f.match(/^(\d+)([rv])/);return m?parseInt(m[1])*2+(m[2]==='r'?0:1):9999}
function foliiSorted(){return Object.keys(DS).sort((a,b)=>sk(a)-sk(b))}
function lerp(t,a,b){return a+(b-a)*t}
function metricColor(v,min,max){
  const t=max>min?(v-min)/(max-min):0;
  const r=Math.round(lerp(t,26,139)),g=Math.round(lerp(t,107,32)),b2=Math.round(lerp(t,92,18));
  return `rgb(${r},${g},${b2})`;
}
function plantOf(f){return DS[f]?.botanical?.plant||'—'}

// OSD viewers map
const viewers = {};
function makeOSD(id, iiif_id){
  if(viewers[id]){viewers[id].destroy();delete viewers[id];}
  const el=document.getElementById(id);
  if(!el)return;
  el.innerHTML='';
  if(!iiif_id){
    el.innerHTML='<div class="ph"><p>Immagine non disponibile</p><a href="https://collections.library.yale.edu/catalog/2002046" target="_blank">Viewer Yale →</a></div>';
    return;
  }
  const tileUrl=`https://collections.library.yale.edu/iiif/2/${iiif_id}`;
  viewers[id]=OpenSeadragon({
    id:id,
    tileSources:{
      "@context":"http://iiif.io/api/image/2/context.json",
      "@id":tileUrl,
      "protocol":"http://iiif.io/api/image",
      "width":3000,"height":4000,
      "profile":["http://iiif.io/api/image/2/level2.json"],
      "tiles":[{"width":256,"scaleFactors":[1,2,4,8]}]
    },
    showNavigator:false,
    showFullPageControl:false,
    showHomeControl:true,
    showZoomControl:true,
    zoomInButton:null,zoomOutButton:null,homeButton:null,
    defaultZoomLevel:0,
    background:'#070503',
    gestureSettingsTouch:{pinchRotate:false},
  });
  viewers[id].addHandler('open-failed',()=>{
    el.innerHTML=`<div class="ph"><div class="ph-g" style="font-size:1.5rem">𝔙</div>
      <p>Il browser ha bloccato il caricamento IIIF Yale.<br>Apri il viewer ufficiale:</p>
      <a href="https://collections.library.yale.edu/catalog/2002046" target="_blank">collections.library.yale.edu →</a></div>`;
  });
}

