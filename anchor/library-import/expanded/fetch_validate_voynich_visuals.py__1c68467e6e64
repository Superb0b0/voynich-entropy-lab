#!/usr/bin/env python3
"""
Scarica e valida i quattro JSON visuali del repository geoffitect/voynich.

Uso:
    python fetch_validate_voynich_visuals.py
    python fetch_validate_voynich_visuals.py --out-dir data_voynich --ref master

Produce:
    <out-dir>/*.json
    <out-dir>/validation_manifest.json

Nota metodologica:
- Il manifest registra URL, SHA-256, dimensione, tipo JSON e struttura top-level.
- Non certifica la correttezza scientifica delle annotazioni né la compatibilità PREREG5.
- Per riproducibilità, usare --ref con un commit SHA immutabile invece di master.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

REPO = "https://raw.githubusercontent.com/geoffitect/voynich/{ref}/{path}"
FILES = {
    "object_catalog.json": "data/visual/object_catalog.json",
    "segmentation_data.json": "data/visual/segmentation_data.json",
    "figure_database.json": "data/lexicon/figure_database.json",
    "plant_analysis.json": "data/analysis/plant_analysis.json",
}

def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()

def shape(value: Any) -> dict[str, Any]:
    result: dict[str, Any] = {"python_type": type(value).__name__}
    if isinstance(value, dict):
        result["top_level_keys"] = sorted(str(k) for k in value.keys())[:200]
        result["key_count"] = len(value)
        result["sample_value_types"] = {
            str(k): type(v).__name__ for k, v in list(value.items())[:30]
        }
    elif isinstance(value, list):
        result["length"] = len(value)
        result["first_item_type"] = type(value[0]).__name__ if value else None
        if value:
            first = value[0]
            if isinstance(first, dict):
                result["first_item_keys"] = sorted(str(k) for k in first.keys())[:200]
    else:
        result["value_preview"] = repr(value)[:160]
    return result

def download(url: str, timeout: int) -> bytes:
    request = urllib.request.Request(
        url,
        headers={"User-Agent": "Voynich-Visual-Data-Validator/1.0"}
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        if response.status != 200:
            raise RuntimeError(f"HTTP status {response.status} for {url}")
        return response.read()

def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--out-dir", default="data_voynich_visual")
    parser.add_argument("--ref", default="master",
                        help="branch, tag o preferibilmente commit SHA")
    parser.add_argument("--timeout", type=int, default=30)
    args = parser.parse_args()

    out_dir = Path(args.out_dir)
    out_dir.mkdir(parents=True, exist_ok=True)
    manifest: dict[str, Any] = {
        "repository": "https://github.com/geoffitect/voynich",
        "ref_requested": args.ref,
        "generated_utc": datetime.now(timezone.utc).isoformat(),
        "files": {},
        "overall_status": "PASS",
        "limitations": [
            "Un hash garantisce l'identità dei byte scaricati, non la validità scientifica dei contenuti.",
            "La compatibilità con PREREG5 richiede uno schema/contratto PREREG5 esplicito.",
            "Se ref è un branch mobile (es. master), ripetere il download può produrre hash diversi."
        ],
    }

    for filename, repo_path in FILES.items():
        url = REPO.format(ref=args.ref, path=repo_path)
        record: dict[str, Any] = {
            "url": url,
            "repository_path": repo_path,
            "status": "FAIL",
        }
        try:
            raw = download(url, args.timeout)
            target = out_dir / filename
            target.write_bytes(raw)
            record["bytes"] = len(raw)
            record["sha256"] = sha256(raw)
            try:
                parsed = json.loads(raw.decode("utf-8-sig"))
            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                record["error"] = f"JSON parse error: {exc}"
                manifest["overall_status"] = "FAIL"
            else:
                record["json"] = shape(parsed)
                record["status"] = "PASS"
            record["local_file"] = str(target.resolve())
        except (urllib.error.URLError, TimeoutError, OSError, RuntimeError) as exc:
            record["error"] = f"{type(exc).__name__}: {exc}"
            manifest["overall_status"] = "FAIL"
        manifest["files"][filename] = record

    manifest_path = out_dir / "validation_manifest.json"
    manifest_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n",
                             encoding="utf-8")
    print(json.dumps(manifest, indent=2, ensure_ascii=False))
    print(f"\nManifest scritto in: {manifest_path.resolve()}")
    return 0 if manifest["overall_status"] == "PASS" else 2

if __name__ == "__main__":
    sys.exit(main())