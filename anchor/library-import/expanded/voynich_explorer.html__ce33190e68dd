<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Voynich Explorer — Model 408-OP</title>
<style>
:root {
  --ink:#1a1208; --perg:#f5ead4; --perg-dark:#e8d5b0; --perg-mid:#c4a882;
  --gold:#c8960a; --gold-l:#e8b420; --red:#8b2012;
  --teal:#1a6b5c; --teal-l:#2a9d8f;
  --mono:'Courier New',monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--ink);color:var(--perg);font-family:Georgia,'Times New Roman',serif;height:100vh;overflow:hidden;display:flex;flex-direction:column}

/* HEADER */
header{background:linear-gradient(180deg,#080604,var(--ink));border-bottom:2px solid var(--gold);padding:12px 24px;display:flex;align-items:center;gap:16px;flex-shrink:0;z-index:100}
.hglyph{font-size:2rem;color:var(--gold);font-style:italic;opacity:.9;text-shadow:0 0 20px rgba(200,150,10,.4)}
header h1{font-size:1.1rem;font-weight:normal;letter-spacing:.1em}
header h1 span{display:block;font-size:.68rem;color:var(--perg-mid);letter-spacing:.2em;text-transform:uppercase;margin-top:2px}
.hmeta{margin-left:auto;font-size:.72rem;color:var(--perg-mid);font-family:var(--mono);text-align:right;line-height:1.5}
.hmeta strong{color:var(--gold-l)}

/* LAYOUT */
.app{display:grid;grid-template-columns:260px 1fr 360px;flex:1;overflow:hidden}

/* SIDEBAR */
.sidebar{background:#0d0a05;border-right:1px solid rgba(200,150,10,.18);display:flex;flex-direction:column;overflow:hidden}
.sb-ctrl{padding:12px 14px;border-bottom:1px solid rgba(200,150,10,.12);flex-shrink:0}
.sb-ctrl input{width:100%;background:rgba(245,234,212,.06);border:1px solid rgba(200,150,10,.28);color:var(--perg);padding:6px 10px;font-family:var(--mono);font-size:.8rem;border-radius:2px;outline:none;margin-bottom:7px}
.sb-ctrl input:focus{border-color:var(--gold)}
.sfilt{display:flex;flex-wrap:wrap;gap:3px}
.sbtn{background:transparent;border:1px solid rgba(200,150,10,.22);color:var(--perg-mid);padding:2px 7px;font-size:.65rem;font-family:var(--mono);cursor:pointer;border-radius:1px;transition:all .14s}
.sbtn:hover,.sbtn.on{background:var(--gold);color:var(--ink);border-color:var(--gold)}
.flist{overflow-y:auto;flex:1;scrollbar-width:thin;scrollbar-color:var(--gold) transparent}
.flist::-webkit-scrollbar{width:3px}
.flist::-webkit-scrollbar-thumb{background:var(--gold)}
.fi{display:flex;align-items:center;gap:8px;padding:8px 14px;cursor:pointer;border-bottom:1px solid rgba(200,150,10,.05);transition:background .1s}
.fi:hover{background:rgba(200,150,10,.07)}
.fi.on{background:rgba(200,150,10,.14);border-left:3px solid var(--gold);padding-left:11px}
.fnum{font-family:var(--mono);font-size:.8rem;color:var(--gold);min-width:38px;font-weight:bold}
.fplt{font-size:.76rem;color:var(--perg-dark);flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fdot{width:6px;height:6px;border-radius:50%;flex-shrink:0}

/* IMAGE */
.imgarea{background:#080604;display:flex;flex-direction:column;overflow:hidden;position:relative}
.imgwrap{flex:1;display:flex;align-items:center;justify-content:center;overflow:hidden;cursor:zoom-in;position:relative}
.imgwrap.zoomed{cursor:zoom-out}
.vimg{max-width:100%;max-height:100%;object-fit:contain;transition:transform .25s ease;transform-origin:center center}
.imgwrap.zoomed .vimg{transform:scale(2.2)}
.ibar{padding:8px 16px;border-top:1px solid rgba(200,150,10,.14);display:flex;align-items:center;gap:10px;background:rgba(0,0,0,.35);flex-shrink:0}
.navbtn{background:transparent;border:1px solid rgba(200,150,10,.3);color:var(--gold);padding:4px 12px;font-family:var(--mono);font-size:.77rem;cursor:pointer;border-radius:1px;transition:all .14s}
.navbtn:hover{background:var(--gold);color:var(--ink)}
.flabel{font-family:var(--mono);font-size:.88rem;color:var(--gold);font-weight:bold}
.slabel{font-size:.72rem;color:var(--perg-mid);margin-left:auto}
.extlink{font-family:var(--mono);font-size:.68rem;color:var(--gold-l);text-decoration:none;border-bottom:1px solid rgba(200,150,10,.3);padding-bottom:1px}
.extlink:hover{border-color:var(--gold)}

/* placeholder */
.ph{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:14px;color:var(--perg-mid);text-align:center;padding:32px}
.ph-g{font-size:3rem;color:rgba(200,150,10,.25);font-style:italic;letter-spacing:3px}
.ph p{font-size:.82rem;line-height:1.7;max-width:280px}
.ph a{color:var(--gold-l);text-decoration:none;font-family:var(--mono);font-size:.75rem}

/* INFO */
.info{background:#0b0905;border-left:1px solid rgba(200,150,10,.18);overflow-y:auto;scrollbar-width:thin;scrollbar-color:rgba(200,150,10,.25) transparent}
.info::-webkit-scrollbar{width:3px}
.info::-webkit-scrollbar-thumb{background:rgba(200,150,10,.3)}
.is{padding:16px 18px;border-bottom:1px solid rgba(200,150,10,.09)}
.is h3{font-size:.63rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);font-family:var(--mono);margin-bottom:10px;padding-bottom:5px;border-bottom:1px solid rgba(200,150,10,.18)}
.pname{font-size:1.15rem;color:var(--perg);margin-bottom:4px}
.cbadge{display:inline-block;font-family:var(--mono);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;padding:2px 7px;border-radius:1px;margin-bottom:8px}
.ch{background:rgba(26,107,92,.28);color:#2ecc71;border:1px solid #2ecc71}
.cm{background:rgba(200,150,10,.18);color:var(--gold-l);border:1px solid var(--gold)}
.cl{background:rgba(139,32,18,.2);color:#e74c3c;border:1px solid #e74c3c}
.cn{background:rgba(80,80,80,.2);color:#777;border:1px solid #444}
.pnotes{font-size:.82rem;line-height:1.68;color:var(--perg-dark)}
.psrc{font-family:var(--mono);font-size:.67rem;color:var(--perg-mid);margin-top:7px}
.sdesc{font-size:.8rem;line-height:1.7;color:var(--perg-dark);background:rgba(26,107,92,.07);border-left:3px solid var(--teal-l);padding:9px 12px;border-radius:0 2px 2px 0}
.sgrid{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.si{background:rgba(245,234,212,.04);border:1px solid rgba(200,150,10,.1);padding:7px 9px;border-radius:2px}
.slb{font-family:var(--mono);font-size:.62rem;color:var(--perg-mid);letter-spacing:.08em;text-transform:uppercase;margin-bottom:2px}
.sv{font-family:var(--mono);font-size:.98rem;color:var(--gold-l);font-weight:bold}
.sbar{height:3px;background:rgba(200,150,10,.12);border-radius:1px;margin-top:4px;overflow:hidden}
.sbf{height:100%;background:var(--gold);border-radius:1px}
.ttbl{width:100%;border-collapse:collapse}
.ttbl th{font-family:var(--mono);font-size:.62rem;color:var(--perg-mid);letter-spacing:.08em;text-transform:uppercase;text-align:left;padding:3px 7px;border-bottom:1px solid rgba(200,150,10,.14)}
.ttbl td{padding:5px 7px;font-family:var(--mono);font-size:.8rem;border-bottom:1px solid rgba(200,150,10,.05)}
.ttbl tr:hover td{background:rgba(200,150,10,.04)}
.tc{color:var(--gold-l);font-weight:bold;position:relative;cursor:help}
.tc:hover .tip{display:block}
.tip{display:none;position:absolute;bottom:calc(100% + 5px);left:0;background:#1a1208;border:1px solid var(--gold);padding:7px 11px;border-radius:2px;font-size:.72rem;white-space:nowrap;z-index:300;color:var(--perg);font-weight:normal;font-family:Georgia,serif;min-width:200px;line-height:1.6}
.tip::after{content:'';position:absolute;top:100%;left:12px;border:5px solid transparent;border-top-color:var(--gold)}
.mnt{font-size:.72rem;color:var(--perg-mid);font-family:var(--mono);background:rgba(0,0,0,.28);border:1px solid rgba(200,150,10,.09);padding:9px 11px;border-radius:2px;line-height:1.6}
.mnt strong{color:var(--gold)}
.empty{display:flex;align-items:center;justify-content:center;height:100%;opacity:.4;font-size:.88rem;flex-direction:column;gap:10px}

/* section dot colors */
.s0{background:#2ecc71}.s1{background:#3498db}.s2{background:#e74c3c}
.s3{background:#f39c12}.s4{background:#9b59b6}.s5{background:#1abc9c}.s6{background:#555}

@media(max-width:900px){
  .app{grid-template-columns:1fr}
  .sidebar,.info{display:none}
}
</style>
</head>
