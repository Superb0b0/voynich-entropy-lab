const GN = 38209;
const SD = {"Herbal-A": "La sezione botanica (ff. 1–66) è la più estesa del manoscritto. Ogni pagina mostra una pianta con testo scritto intorno. Le identificazioni sono contestate: Tucker & Talbert (2013) propongono piante mesoamericane; Sherwood e Bax suggeriscono origini europee o mediorientali.", "Astronomical": "I folii 67–74 contengono diagrammi circolari con stelle e figure zodiacali. I nomi dei mesi appaiono in scrittura latina, con nomi di stelle in una grafia vicina all'arabo o al provenzale antico.", "Biological": "La sezione biologica (ff. 75–84) mostra figure femminili immerse in vasche collegate da tubi. Interpretata come cosmologia del corpo, balneologia termale, o testo alchimico.", "Cosmological": "I folii 85–86 hanno diagrammi cosmologici a più cerchi, simili a mappe del mondo medievali o schemi del firmamento.", "Pharmaceutical": "Folii 87–102: piccoli contenitori con radici o parti di piante. Probabilmente un formulario farmaceutico con dosi e preparazioni.", "Recipes-Stars": "Gli ultimi folii (103–116) contengono testo denso con stelle nel margine, interpretato come ricette mediche o invocazioni.", "Unknown": "Sezione non classificata."};
const SNAMES = ["Herbal-A","Astronomical","Biological","Cosmological","Pharmaceutical","Recipes-Stars","Unknown"];
const SCOLS  = ["s0","s1","s2","s3","s4","s5","s6"];

let cur=null, sec='all', order=[], zoomed=false;

function sk(f){const m=f.match(/^(\d+)([rv])/);return m?parseInt(m[1])*2+(m[2]==='r'?0:1):9999}

function renderList(q='',s='all'){
  const el=document.getElementById('flist');
  el.innerHTML=''; order=[];
  const folii=Object.keys(DS).sort((a,b)=>sk(a)-sk(b));
  for(const f of folii){
    const d=DS[f];
    if(s!=='all'&&d.section!==s)continue;
    if(q){const qq=q.toLowerCase();if(!f.includes(qq)&&!(d.botanical?.plant||'').toLowerCase().includes(qq))continue;}
    order.push(f);
    const sc=SCOLS[SNAMES.indexOf(d.section)]||'s6';
    const pl=d.botanical?.plant||'—';
    const div=document.createElement('div');
    div.className='fi'+(f===cur?' on':'');
    div.dataset.f=f;
    div.innerHTML=`<span class="fnum">f${f}</span><span class="fplt">${pl}</span><span class="fdot ${sc}"></span>`;
    div.onclick=()=>load(f);
    el.appendChild(div);
  }
}

function load(f){
  cur=f; zoomed=false;
  document.querySelectorAll('.fi').forEach(e=>e.classList.toggle('on',e.dataset.f===f));
  const d=DS[f], idx=order.indexOf(f);
  document.getElementById('fl').textContent='f'+f;
  document.getElementById('sl').textContent=d.section||'';
  document.getElementById('pb').onclick=()=>{if(idx>0)load(order[idx-1])};
  document.getElementById('nb').onclick=()=>{if(idx<order.length-1)load(order[idx+1])};
  // Yale IIIF link diretto al catalog
  document.getElementById('yl').href='https://collections.library.yale.edu/catalog/2002046';
  renderImg(f,d);
  renderInfo(f,d);
  document.querySelector('.fi.on')?.scrollIntoView({block:'nearest',behavior:'smooth'});
}

function renderImg(f,d){
  const iw=document.getElementById('iw');
  iw.innerHTML='';
  iw.className='imgwrap';
  iw.onclick=()=>{zoomed=!zoomed;iw.classList.toggle('zoomed',zoomed)};
  
  if(!d.img_full){showPH(f,d,iw);return;}
  
  const img=document.createElement('img');
  img.className='vimg';
  img.alt='Voynich f'+f;
  img.title='Click per zoom';
  
  // Tenta full, poi thumb, poi placeholder
  const urls=[d.img_full, d.img_thumb];
  let ui=0;
  function tryNext(){
    if(ui<urls.length){img.src=urls[ui++];}
    else{showPH(f,d,iw);}
  }
  img.onerror=tryNext;
  img.onload=()=>{};
  iw.appendChild(img);
  tryNext();
}

function showPH(f,d,iw){
  iw.onclick=null;
  const n=f.match(/(\d+)/)?.[1]||'';
  const sid=f.match(/([rv])/)?.[1]||'r';
  iw.innerHTML=`
    <div class="ph">
      <div class="ph-g" style="font-size:1.6rem;letter-spacing:2px">${(d.stats?.top5||[]).slice(0,3).map(t=>t.tok).join(' · ')}</div>
      <p><strong style="color:var(--gold)">f${f}</strong> — ${d.botanical?.plant||'?'}</p>
      <p style="font-size:.75rem">Il browser ha bloccato il caricamento dell'immagine Yale.<br>Apri il viewer ufficiale:</p>
      <a href="https://collections.library.yale.edu/catalog/2002046" target="_blank" style="margin-top:4px">
        Viewer Yale Beinecke →
      </a>
      <a href="https://www.google.com/search?q=voynich+folio+${n}${sid}&tbm=isch" target="_blank" style="margin-top:6px;font-size:.7rem">
        Google Images →
      </a>
    </div>`;
}

function renderInfo(f,d){
  const bot=d.botanical||{}, st=d.stats||{}, top5=st.top5||[];
  const sec=d.section||'Unknown';
  const cf={'high':'ch','medium':'cm','low':'cl',''  :'cn'};
  const cl={'high':'Alta confidenza','medium':'Media confidenza','low':'Bassa confidenza',''  :'Nessuna identificazione'};
  
  const rows=top5.map(t=>{
    const lr=st.n?t.n/st.n:0;
    const gr=t.global/GN;
    const en=gr>0?(lr/gr).toFixed(1):'—';
    const enN=parseFloat(en);
    const ec=enN>=5?'#e74c3c':enN>=2?'#f39c12':'var(--perg-mid)';
    return `<tr>
      <td class="tc">${t.tok}<span class="tip">Token: <strong>${t.tok}</strong><br>
        In questo folio: ${t.n}/${st.n||0}<br>
        Nel corpus: ${t.global}/${GN}<br>
        Arricchimento: ${en}×<br>
        <em style="color:var(--perg-mid)">Significato: non determinato</em></span></td>
      <td style="text-align:right;color:var(--perg-dark)">${t.n}</td>
      <td style="text-align:right;color:var(--perg-mid);font-size:.73rem">${t.global}</td>
      <td style="text-align:right;color:${ec};font-size:.75rem">${isNaN(enN)?'—':en+'×'}</td>
    </tr>`;
  }).join('');

  const h1p=Math.min((st.H1||0)/12*100,100);
  const tp=Math.min((st.TTR||0)*100,100);
  const xp=Math.min((st.XX||0)*1500,100);
  const ap=Math.min((st.AAB||0)*1500,100);

  document.getElementById('info').innerHTML=`
    <div class="is">
      <h3>Identificazione botanica</h3>
      ${bot.plant?`
        <div class="pname">${bot.plant}</div>
        <span class="cbadge ${cf[bot.confidence||'']}">${cl[bot.confidence||'']}</span>
        <p class="pnotes">${bot.notes||''}</p>
        <p class="psrc">Fonte: ${bot.source||'—'}</p>
      `:`<p class="pnotes" style="color:var(--perg-mid)">Nessuna identificazione botanica consolidata.</p>`}
    </div>
    <div class="is">
      <h3>Sezione · ${sec}</h3>
      <div class="sdesc">${SD[sec]||''}</div>
    </div>
    <div class="is">
      <h3>Struttura statistica — Model 408-OP</h3>
      <div class="sgrid">
        <div class="si"><div class="slb">Entropia H₁</div><div class="sv">${st.H1||'—'}</div>
          <div class="sbar"><div class="sbf" style="width:${h1p}%"></div></div></div>
        <div class="si"><div class="slb">TTR</div><div class="sv">${st.TTR||'—'}</div>
          <div class="sbar"><div class="sbf" style="width:${tp}%"></div></div></div>
        <div class="si"><div class="slb">XX rate</div><div class="sv">${st.XX||'—'}</div>
          <div class="sbar"><div class="sbf" style="width:${xp}%;background:var(--red)"></div></div></div>
        <div class="si"><div class="slb">AAB rate</div><div class="sv">${st.AAB||'—'}</div>
          <div class="sbar"><div class="sbf" style="width:${ap}%;background:var(--teal-l)"></div></div></div>
      </div>
      <p style="font-size:.68rem;color:var(--perg-mid);margin-top:8px;font-family:var(--mono)">
        Token: ${st.n||0} · Unici: ${st.n&&st.TTR?Math.round(st.n*st.TTR):'—'}
      </p>
    </div>
    <div class="is">
      <h3>Token caratteristici (hover per dettagli)</h3>
      <table class="ttbl">
        <thead><tr>
          <th>Token</th><th style="text-align:right">Locale</th>
          <th style="text-align:right">Globale</th><th style="text-align:right">Enrich.</th>
        </tr></thead>
        <tbody>${rows}</tbody>
      </table>
    </div>
    <div class="is">
      <h3>Note Model 408-OP</h3>
      <div class="mnt">
        <strong>Avvertenza:</strong> i dati sono il risultato di analisi computazionale (7 fasi).
        I token mostrati non sono traduzioni — sono distribuzioni di frequenza.<br><br>
        <strong>Enrich.</strong> = frequenza locale / attesa globale.<br>
        <strong>XX</strong> = auto-ripetizioni A→A. <strong>AAB</strong> = pattern enumerativo.<br><br>
        Identificazioni: Tucker & Talbert (2013), Bax (2014), Sherwood (2008).<br>
        Immagini: © Yale Beinecke Library, pubblico dominio.
      </div>
    </div>`;
}

// ── INIT ──
document.getElementById('srch').addEventListener('input',e=>renderList(e.target.value,sec));
document.getElementById('sfilt').addEventListener('click',e=>{
  const b=e.target.closest('.sbtn');
  if(!b)return;
  document.querySelectorAll('.sbtn').forEach(x=>x.classList.remove('on'));
  b.classList.add('on');
  sec=b.dataset.s;
  renderList(document.getElementById('srch').value,sec);
});

renderList();
const first=Object.keys(DS).sort((a,b)=>sk(a)-sk(b)).find(f=>DS[f].botanical?.plant)||Object.keys(DS).sort((a,b)=>sk(a)-sk(b))[0];
if(first)load(first);
</script>
</body>
</html>