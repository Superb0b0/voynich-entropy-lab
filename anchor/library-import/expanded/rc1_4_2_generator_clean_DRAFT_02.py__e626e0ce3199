class Blocked(RuntimeError):
    """Fail-closed: one unverified assertion invalidates the complete run."""


def require(condition: bool, reason: str) -> None:
    if not condition:
        raise Blocked(reason)


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def checked_bytes(path: Path, expected_sha: str, expected_size: int | None = None) -> bytes:
    """Read exact bytes, with no fallback to generated or substituted sources."""
    require(path.is_file() and not path.is_symlink(), f"INPUT_MISSING_OR_LINK:{path.name}")
    data = path.read_bytes()
    require(sha256(data) == expected_sha, f"INPUT_HASH_MISMATCH:{path.name}")
    require(expected_size is None or len(data) == expected_size,
            f"INPUT_SIZE_MISMATCH:{path.name}")
    return data


def norm(value: str) -> tuple[str, list[str]]:
    """Normalize folio IDs, preserve non-folio identifiers and flag anomalies."""
    require(isinstance(value, str) and bool(value.strip()), "EMPTY_IDENTIFIER")
    clean = value.strip()
    m = FOLIO_RE.fullmatch(clean)
    if m:
        num = int(m.group(1))
        flags = ["ZERO_FOLIO_NUMBER"] if num == 0 else []
        return f"f{num}{m.group(2).lower()}", flags
    if clean.startswith("_"):
        return clean, []
    return clean, ["NONSTANDARD_NONFOLIO_IDENTIFIER"]


def parse_csv(data: bytes, expected_fields: set[str]) -> list[dict[str, str]]:
    try:
        text = data.decode("utf-8-sig")
    except UnicodeDecodeError as exc:
        raise Blocked("CSV_NOT_UTF8") from exc
    reader = csv.DictReader(io.StringIO(text, newline=""))
    require(reader.fieldnames is not None and len(set(reader.fieldnames)) == len(reader.fieldnames),
            "CSV_HEADER_DUPLICATE_OR_MISSING")
    require(expected_fields <= set(reader.fieldnames), "CSV_REQUIRED_FIELD_MISSING")
    rows = list(reader)
    require(all(None not in row and all(v is not None for v in row.values()) for row in rows),
            "CSV_ROW_RAGGED")
    return rows


def canonical_json(value: Any) -> bytes:
    return (json.dumps(value, ensure_ascii=False, sort_keys=True, indent=2,
                       allow_nan=False) + "\n").encode("utf-8")


def canonical_csv(rows: list[dict], fields: list[str]) -> bytes:
    stream = io.StringIO(newline="")
    writer = csv.DictWriter(stream, fieldnames=fields, lineterminator="\n",
                            extrasaction="raise")
    writer.writeheader()
    def ordering(row: dict) -> tuple[str, str, str]:
        return (norm(row["image_id"])[0], row.get("folio_key", ""), row["image_id"])
    for row in sorted(rows, key=ordering):
        require(set(row) == set(fields), "CSV_OUTPUT_SCHEMA_MISMATCH")
        writer.writerow(row)
    return stream.getvalue().encode("utf-8")


def verify_contract(config_raw: bytes, config: dict) -> None:
    require(sha256(config_raw) == CONFIG_SHA256, "CONFIG_HASH")
    require(config.get("revision") == "RC1.4.2-V7.1", "CONFIG_VERSION")
    require(config["gate"]["status"] == GATE, "GATE_CHANGED")
    require(config["gate"]["validation_artifact_generation_allowed"] is False,
            "FROZEN_GATE_UNEXPECTEDLY_OPEN")
    require(config["aggregation"]["primary_key"] == "normalized_folio_key",
            "AGGREGATION_KEY")
    require(config["aggregation"]["derived_fields"]["token_count"]["operation"] ==
            "COUNT_UNION_AFTER_DISJOINTNESS_PROOF", "BLIND_SUM_PROHIBITED")
    require(config["eligibility"]["threshold"] == THRESHOLD and
            config["eligibility"]["operator"] == ">=", "THRESHOLD_CONTRACT")
    require(tuple(config["validation_report_contract"]["required_sections"]) == SECTIONS,
            "REPORT_SECTIONS_CONTRACT")
    require(set(config["validation_report_contract"]["required_control_status_values"]) ==
            {"PASS", "FAIL", "NOT_RUN"}, "CONTROL_STATUS_CONTRACT")
    tok = config["aggregation"]["multipanel_token_disjointness"]["tokenization"]
    require(tok["parser_sha256"] == PARSER_SHA256 and
            tok["provenance_mapper_sha256"] == MAPPER_SHA256, "PINNED_PARSER_CONTRACT")
    require(config["exceptions"]["f085v"]["status"] == "unresolved" and
            config["exceptions"]["f085v"]["manual_association_allowed"] is False,
            "F085V_CONTRACT")
    require(config["manifest_contract"]["gate_status"] == GATE,
            "MANIFEST_GATE_CONTRACT")


def verify_input_integrity(root: Path, config_path: Path) -> dict:
    """Only raw read operations. Historical 'verified' flags are not evidence."""
    raw_config = checked_bytes(config_path, CONFIG_SHA256)
    config = json.loads(raw_config.decode("utf-8"))
    verify_contract(raw_config, config)
    items, hashes = {}, {"configuration": sha256(raw_config)}
    for name, spec in sorted(config["inputs"].items()):
        data = checked_bytes(root / spec["filename"], spec["expected_sha256"],
                             spec["expected_bytes"])
        if name == "corpus_metadata":
            git_blob = hashlib.sha1(b"blob " + str(len(data)).encode("ascii") +
                                    b"\x00" + data).hexdigest()
            require(git_blob == spec["git_blob_sha"], "YALE_GIT_BLOB_MISMATCH")
        items[name] = data
        hashes[spec["filename"]] = sha256(data)
    raw_source = checked_bytes(root / "ZL3b-n.txt", CORPUS_SHA256, CORPUS_BYTES)
    hashes["ZL3b-n.txt"] = sha256(raw_source)
    for name, expected_sha in (("ivtff_parser_rc1_4.py", PARSER_SHA256),
                               ("ivtff_parser_rc1_4_offset_aware.py", MAPPER_SHA256)):
        hashes[name] = sha256(checked_bytes(root / name, expected_sha))
    return {"config": config, "raw": items, "source": raw_source,
            "hashes": hashes, "root": root}


def validate_profiles(profiles: Any) -> tuple[dict[str, dict], list[str]]:
    """No dimensionality reduction, semantic transformation, or scoring."""
    require(isinstance(profiles, list) and len(profiles) == 206, "PROFILE_COUNT")
    by_id, anomalies = {}, []
    for entry in profiles:
        require(isinstance(entry, dict), "PROFILE_NOT_OBJECT")
        original = entry.get("image_id")
        key, flags = norm(original)
        require(key not in by_id, f"NORMALIZED_PROFILE_COLLISION:{key}")
        if not original.startswith("_"):
            require(FOLIO_RE.fullmatch(original.strip()) is not None,
                    f"PROFILE_NONFOLIO_ID:{original}")
        anomalies += [f"PROFILE:{original}:{flag}" for flag in flags]
        vec = entry.get("archetype_vector")
        require(isinstance(vec, list) and len(vec) == 768,
                f"VECTOR_768:{original}")
        require(all(type(v) in (int, float) and math.isfinite(v) for v in vec),
                f"VECTOR_NONFINITE:{original}")
        scores = entry.get("archetype_scores")
        require(isinstance(scores, dict) and set(scores) == ARCHETYPES,
                f"ARCHETYPE_16_CATEGORIES:{original}")
        require(all(type(v) in (int, float) and math.isfinite(v) for v in scores.values()),
                f"ARCHETYPE_NONFINITE:{original}")
        emotions = entry.get("emotion_distribution")
        require(isinstance(emotions, dict) and set(emotions) == EMOTIONS,
                f"EMOTION_9_CATEGORIES:{original}")
        require(all(type(v) in (int, float) and math.isfinite(v) for v in emotions.values()),
                f"EMOTION_NONFINITE:{original}")
        require(entry.get("dominant_emotion") in EMOTIONS,
                f"DOMINANT_EMOTION_NOT_IN_CATEGORIES:{original}")
        require(type(entry.get("archetype_magnitude")) in (int, float) and
                math.isfinite(entry["archetype_magnitude"]),
                f"ARCHETYPE_MAGNITUDE_NONFINITE:{original}")
        require(entry.get("mode") == "voynich", f"PROFILE_MODE:{original}")
        require(isinstance(entry.get("metadata"), dict) and
                isinstance(entry.get("source_path"), str), f"PROFILE_SCHEMA:{original}")
        by_id[key] = entry
    require(sum(x.startswith("_") for x in by_id) == 9, "COVER_BINDING_COUNT")
    return by_id, sorted(anomalies)


def validate_yale_metadata(rows: list[dict], profile_keys: set[str]) -> tuple[dict, list[str]]:
    """213 canvas rows; repeated image_id != duplicated Yale canvas."""
    require(len(rows) == 213, "YALE_METADATA_213_ROWS")
    by_image: dict[str, set[str]] = defaultdict(set)
    canvas_ids, anomalies = set(), []
    for item in rows:
        original = item["image_id"]
        key, flags = norm(original)
        if not original.startswith("_"):
            require(FOLIO_RE.fullmatch(original.strip()) is not None,
                    f"METADATA_NONFOLIO_ID:{original}")
        anomalies += [f"YALE:{original}:{flag}" for flag in flags]
        service = CANVAS_RE.fullmatch(item["image_service_url"].strip())
        manifest = MANIFEST_CANVAS_RE.fullmatch(item["canvas_id"].strip())
        require(service is not None and manifest is not None and
                service.group(1) == manifest.group(1), f"YALE_CANVAS_REFERENCE:{original}")
        canvas = service.group(1)
        require(canvas not in canvas_ids, f"YALE_DUPLICATE_CANVAS:{canvas}")
        canvas_ids.add(canvas)
        require(canvas not in by_image[key], f"IMAGE_CANVAS_DUPLICATE:{key}")
        by_image[key].add(canvas)
    require(set(by_image) == profile_keys and len(by_image) == 206,
            "PROFILE_METADATA_NORMALIZED_SET_MISMATCH")
    repeat = {k: sorted(v) for k, v in by_image.items() if len(v) > 1}
    require(len(repeat) == 7 and all(len(v) == 2 for v in repeat.values()),
            "YALE_REPEATED_IMAGE_GROUPS")
    require(len(canvas_ids) == 213, "YALE_CANVAS_CARDINALITY")
    return {"image_to_canvases": dict(by_image), "double_canvases": repeat,
            "canvas_count": len(canvas_ids), "image_count": len(by_image)}, sorted(anomalies)


